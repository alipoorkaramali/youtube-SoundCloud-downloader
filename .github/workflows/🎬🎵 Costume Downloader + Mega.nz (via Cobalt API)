name: 🎬🎵 Costume Downloader + Mega.nz (via Cobalt API)

on:
  workflow_dispatch:
    inputs:
      platform:
        description: '🌐 پلتفرم'
        required: true
        default: 'youtube'
        type: choice
        options:
          - youtube
          - soundcloud
      url:
        description: '🔗 لینک دانلود'
        required: true
      type:
        description: 'نوع دانلود'
        required: true
        default: 'audio'
        type: choice
        options:
          - audio
          - video
      quality:
        description: '🎬 کیفیت ویدیو (فقط برای حالت ویدیو)'
        required: false
        default: 'best'
        type: choice
        options:
          - '144p'
          - '240p'
          - '360p'
          - '480p'
          - '720p'
          - '1080p'
          - 'best'
      folder:
        description: '📁 پوشه موقت'
        required: false
        default: 'downloads'
      mega_folder:
        description: '📂 پوشه در Mega.nz'
        required: false
        default: 'YoutubeDownloads'
      split_choice:
        description: 'تقسیم فایل به چند قسمت (ZIP volume)؟'
        required: true
        default: 'single'
        type: choice
        options:
          - single
          - split
      split_size:
        description: 'اندازه هر قسمت (مثال: 100M, 500M, 1G)'
        required: false
        default: '100M'

jobs:
  download:
    runs-on: ubuntu-latest
    steps:
      - name: 📥 Checkout Repository
        uses: actions/checkout@v4

      - name: ⚙️ Install dependencies (jq, curl, zip)
        run: |
          sudo apt-get update
          sudo apt-get install -y jq zip

      - name: 💾 Cache rclone binary
        id: cache-rclone
        uses: actions/cache@v4
        with:
          path: /usr/bin/rclone
          key: ${{ runner.os }}-rclone-v1.74.0

      - name: 📦 Install latest rclone (if not cached)
        if: steps.cache-rclone.outputs.cache-hit != 'true'
        run: |
          curl https://rclone.org/install.sh | sudo bash
          rclone version

      - name: 🔓 Decrypt rclone config
        run: |
          mkdir -p ~/.config/rclone
          if [ ! -f rclone_mega.conf.gpg ]; then
            echo "❌ فایل rclone_mega.conf.gpg در ریشه مخزن پیدا نشد!"
            exit 1
          fi
          gpg --quiet --batch --yes --decrypt --passphrase="${{ secrets.RCLONE_PASSPHRASE }}" --output ~/.config/rclone/rclone.conf rclone_mega.conf.gpg
          chmod 600 ~/.config/rclone/rclone.conf
          echo "✅ rclone config loaded"
          rclone --config ~/.config/rclone/rclone.conf listremotes

      - name: ▶️ دانلود فایل با Cobalt API
        id: download
        run: |
          # حذف پوشه قبلی در صورت وجود
          rm -rf "${{ github.event.inputs.folder }}" 2>/dev/null || true
          mkdir -p "${{ github.event.inputs.folder }}"
          cd "${{ github.event.inputs.folder }}"

          # ساخت payload برای Cobalt بر اساس ورودی‌ها
          if [ "${{ github.event.inputs.type }}" = "video" ]; then
            # نگاشت کیفیت انتخابی به فرمت Cobalt
            QUALITY_INPUT="${{ github.event.inputs.quality }}"
            case "$QUALITY_INPUT" in
              "144p")  V_QUALITY="144" ;;
              "240p")  V_QUALITY="240" ;;
              "360p")  V_QUALITY="360" ;;
              "480p")  V_QUALITY="480" ;;
              "720p")  V_QUALITY="720" ;;
              "1080p") V_QUALITY="1080" ;;
              "best")  V_QUALITY="max" ;;
              *)       V_QUALITY="720" ;;
            esac
            # همیشه از h264 استفاده می‌کنیم برای سازگاری بیشتر
            PAYLOAD=$(jq -n \
              --arg url "${{ github.event.inputs.url }}" \
              --arg vQuality "$V_QUALITY" \
              '{url: $url, vQuality: $vQuality, vCodec: "h264", isAudioOnly: false}')
          else
            # حالت صوتی (mp3)
            PAYLOAD=$(jq -n \
              --arg url "${{ github.event.inputs.url }}" \
              '{url: $url, isAudioOnly: true, audioFormat: "mp3"}')
          fi

          echo "Payload: $PAYLOAD"

          # ارسال درخواست به Cobalt API
          RESPONSE=$(curl -s -X POST https://api.cobalt.tools/api/json \
            -H 'Accept: application/json' \
            -H 'Content-Type: application/json' \
            -d "$PAYLOAD")

          echo "Response: $RESPONSE"

          # استخراج لینک و نام فایل
          STATUS=$(echo "$RESPONSE" | jq -r '.status // "error"')
          if [ "$STATUS" = "error" ]; then
            echo "❌ خطا از سمت Cobalt: $(echo "$RESPONSE" | jq -r '.text')"
            exit 1
          fi

          DOWNLOAD_URL=$(echo "$RESPONSE" | jq -r '.url')
          if [ -z "$DOWNLOAD_URL" ] || [ "$DOWNLOAD_URL" = "null" ]; then
            echo "❌ لینک دانلود دریافت نشد!"
            exit 1
          fi

          FILENAME=$(echo "$RESPONSE" | jq -r '.filename // "downloaded_file"')
          # حذف کاراکترهای نامناسب برای نام فایل
          SAFE_FILENAME=$(echo "$FILENAME" | sed 's/[\\/:*?"<>|]/_/g')

          echo "📥 دانلود فایل از $DOWNLOAD_URL"
          curl -L -o "$SAFE_FILENAME" "$DOWNLOAD_URL"

          # بررسی وجود فایل دانلود شده
          if [ ! -f "$SAFE_FILENAME" ]; then
            echo "❌ فایل دانلود نشد!"
            exit 1
          fi

          # ذخیره نام فایل در متغیر محیطی برای مراحل بعد
          echo "DOWNLOADED_FILE=$SAFE_FILENAME" >> $GITHUB_ENV
          echo "✅ دانلود با موفقیت انجام شد: $SAFE_FILENAME"

      - name: ✂️ Split into zip volumes (if requested)
        if: github.event.inputs.split_choice == 'split'
        run: |
          cd "${{ github.event.inputs.folder }}"
          FILE="${{ env.DOWNLOADED_FILE }}"
          SIZE="${{ github.event.inputs.split_size }}"
          echo "Creating zip volumes of $SIZE from $FILE"
          zip -s "$SIZE" "${FILE}.zip" "$FILE"
          rm "$FILE"
          echo "✅ Zip volumes created:"
          ls -la

      - name: ☁️ آپلود به Mega.nz
        run: |
          CONFIG_FILE="$HOME/.config/rclone/rclone.conf"
          REMOTE_PATH="mega:${{ github.event.inputs.mega_folder }}"
          rclone --config "$CONFIG_FILE" mkdir "$REMOTE_PATH" 2>/dev/null || true
          rclone --config "$CONFIG_FILE" copy "${{ github.event.inputs.folder }}" "$REMOTE_PATH" --progress --transfers=4 --verbose
          echo "✅ آپلود با موفقیت انجام شد"